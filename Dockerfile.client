# Build Stage
FROM node:18-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

# Serve Stage
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
# Copy default custom nginx configuration if needed, otherwise standard default nginx serves SPA index.html on port 80
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
